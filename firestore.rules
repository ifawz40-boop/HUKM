rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Strict email verification: email_verified == true strictly from ID Token (NO provider shortcuts)
    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Authoritative Custom Claims based roles (Strictly Token Claims, ZERO email fallbacks)
    // Authoritative Custom Claims based roles:
    // Requires verified Custom Claim 'owner' AND active registration in /admins/{uid}
    // to guarantee that no orphaned or incomplete claim can bypass the bootstrap registry.
    function isOwner() {
      return isSignedIn() && 
             isEmailVerified() && 
             request.auth.token.role == 'owner' &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin role requires Custom Claim 'admin' AND active registration in /admins/{uid} for instant revocation
    function isAdmin() {
      return isOwner() || (
        isSignedIn() && 
        isEmailVerified() && 
        request.auth.token.role == 'admin' &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Draft identity is immutable after creation. This protects against races where
    // two clients preflight the same truncated/legacy ID before either batch commits.
    function isValidDraftChapterCreate(draftId) {
      let data = incoming();
      return isAdmin() &&
             isValidId(draftId) &&
             data.keys().hasAll(['id', 'bookId', 'chapterId', 'status']) &&
             data.id == draftId &&
             data.bookId is string && data.bookId.size() > 0 && data.bookId.size() <= 128 &&
             data.chapterId is string && data.chapterId.size() > 0 && data.chapterId.size() <= 128 &&
             data.status == 'draft';
    }

    function isValidDraftChapterUpdate(draftId) {
      let data = incoming();
      let previous = existing();
      return isAdmin() &&
             isValidId(draftId) &&
             data.keys().hasAll(['id', 'bookId', 'chapterId', 'status']) &&
             data.id == draftId &&
             data.bookId == previous.bookId &&
             data.chapterId == previous.chapterId &&
             data.status == 'draft';
    }

    // Reader annotations are private user-owned excerpts and notes.
    function isValidReaderAnnotationCreate(userId, bookId, chapterId, annotationId) {
      let data = incoming();
      return isSignedIn() &&
             request.auth.uid == userId &&
             isValidId(bookId) &&
             isValidId(chapterId) &&
             isValidId(annotationId) &&
             data.keys().hasOnly(['id', 'userId', 'bookId', 'chapterId', 'paragraphIndex', 'startOffset', 'endOffset', 'selectedText', 'note', 'color', 'createdAt', 'updatedAt']) &&
             data.keys().hasAll(['id', 'userId', 'bookId', 'chapterId', 'paragraphIndex', 'startOffset', 'endOffset', 'selectedText', 'note', 'color', 'createdAt', 'updatedAt']) &&
             data.id == annotationId &&
             data.userId == userId &&
             data.bookId == bookId &&
             data.chapterId == chapterId &&
             data.paragraphIndex is int && data.paragraphIndex >= 0 &&
             data.startOffset is int && data.startOffset >= 0 &&
             data.endOffset is int && data.endOffset > data.startOffset &&
             data.selectedText is string && data.selectedText.size() > 0 && data.selectedText.size() <= 2000 &&
             data.note is string && data.note.size() <= 2000 &&
             data.color in ['gold', 'green', 'blue', 'rose'] &&
             data.createdAt is string && data.createdAt.size() <= 40 &&
             data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    function isValidReaderAnnotationUpdate(userId, bookId, chapterId, annotationId) {
      let data = incoming();
      let previous = existing();
      let affected = data.diff(previous).affectedKeys();
      return isSignedIn() &&
             request.auth.uid == userId &&
             previous.userId == userId &&
             previous.bookId == bookId &&
             previous.chapterId == chapterId &&
             data.id == annotationId &&
             data.userId == userId &&
             data.bookId == bookId &&
             data.chapterId == chapterId &&
             data.paragraphIndex == previous.paragraphIndex &&
             data.startOffset == previous.startOffset &&
             data.endOffset == previous.endOffset &&
             data.createdAt == previous.createdAt &&
             affected.hasOnly(['note', 'color', 'updatedAt']) &&
             data.selectedText is string && data.selectedText.size() > 0 && data.selectedText.size() <= 2000 &&
             data.note is string && data.note.size() <= 2000 &&
             data.color in ['gold', 'green', 'blue', 'rose'] &&
             data.updatedAt is string && data.updatedAt.size() <= 40;
    }

    // 1. Users Collection
    // Strict field-level validation: Users may update only approved profile fields.
    // Users must NEVER set or change role, accountStatus, permissions, or administrative metadata.
    function isValidUserProfileCreate() {
      let data = incoming();
      return data.keys().hasOnly(['uid', 'displayName', 'name', 'email', 'photoURL', 'avatar', 'bio', 'joinedDate', 'bookmarks', 'readHistory', 'updatedAt']) &&
             data.uid == request.auth.uid &&
             (!('email' in data) || data.email is string) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
             (!('bookmarks' in data) || data.bookmarks is list) &&
             (!('readHistory' in data) || data.readHistory is list);
    }

    function isValidUserProfileUpdate() {
      let incomingData = incoming();
      let existingData = existing();
      let affected = incomingData.diff(existingData).affectedKeys();
      return affected.hasOnly(['displayName', 'name', 'photoURL', 'avatar', 'bio', 'bookmarks', 'readHistory', 'updatedAt']) &&
             (!('displayName' in incomingData) || (incomingData.displayName is string && incomingData.displayName.size() <= 100)) &&
             (!('name' in incomingData) || (incomingData.name is string && incomingData.name.size() <= 100)) &&
             (!('bio' in incomingData) || (incomingData.bio is string && incomingData.bio.size() <= 1000)) &&
             (!('bookmarks' in incomingData) || incomingData.bookmarks is list) &&
             (!('readHistory' in incomingData) || incomingData.readHistory is list);
    }

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUserProfileCreate();
      allow update: if isSignedIn() && (
        (request.auth.uid == userId && isValidUserProfileUpdate()) ||
        isOwner()
      );
      allow delete: if isOwner();

      // Private reader notes are isolated by user, book, and chapter path.
      match /readerAnnotations/{bookId}/chapters/{chapterId}/readerAnnotationEntries/{annotationId} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isValidReaderAnnotationCreate(userId, bookId, chapterId, annotationId);
        allow update: if isValidReaderAnnotationUpdate(userId, bookId, chapterId, annotationId);
        allow delete: if isSignedIn() &&
                         request.auth.uid == userId &&
                         resource.data.userId == userId &&
                         resource.data.bookId == bookId &&
                         resource.data.chapterId == chapterId;
      }
    }

    // Collection-group reads for the signed-in user's private reading notebook only.
    match /{path=**}/readerAnnotationEntries/{annotationId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // 2. Books Collection
    // Public users can ONLY read published books. Drafts are restricted to admins/owner!
    match /books/{bookId} {
      allow read: if (resource.data.status in ['published', 'completed', 'ongoing', 'ready']) || isAdmin();
      allow create, update, delete: if isAdmin() && isValidId(bookId);
    }

    // 3. Categories Collection: Public can read, Admins can write
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(categoryId);
    }

    // 4. Admins Registry:
    // Only verified Admins and Owner can read.
    // ONLY OWNER can create, update, or delete admins. ADMINS CANNOT ASSIGN OR REVOKE ADMIN ROLES!
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow create, update, delete: if isOwner() && isValidId(adminId);
    }

    // 5. Admin Requests: private records are accessible only through the authenticated server API.
    match /adminRequests/{requestId} {
      allow read, write: if false;
    }

    // 6. Bans and Moderation:
    // Public users CANNOT read private bans. Only Admins can read or write bans.
    match /bans/{banId} {
      allow read, write: if isAdmin() && isValidId(banId);
    }

    // 7. Notifications Collection:
    // Public announcements can be read by anyone. Private notifications only by recipient or Admin.
    match /notifications/{notificationId} {
      allow read: if (resource.data.targetRole == 'all') || 
                     (isSignedIn() && (request.auth.uid == resource.data.targetUid || isAdmin()));
      allow create, update, delete: if isAdmin() && isValidId(notificationId);
    }

    // 8. Subscribers Collection:
    // Public users cannot read subscriber information! Only Admins can read or manage subscribers.
    match /subscribers/{subscriberId} {
      allow read: if isAdmin();
      allow create: if isValidId(subscriberId) &&
                       incoming().keys().hasOnly(['id', 'email', 'name', 'subscribedAt', 'source', 'active', 'receiveAllReleases']) &&
                       incoming().id == subscriberId &&
                       incoming().email is string &&
                       incoming().email.size() <= 256 &&
                       incoming().email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$') &&
                       incoming().active == true;
      allow update, delete: if isAdmin();
    }

    // 9. Reading Progress:
    // Strict user ownership and field validation. Users cannot alter userId or tamper with other users' records.
    function isValidReadingProgressCreate(progressId) {
      let data = incoming();
      return data.keys().hasOnly(['id', 'userId', 'bookId', 'chapterId', 'chapterIndex', 'scrollPercent', 'lastReadAt', 'completed', 'updatedAt']) &&
             data.keys().hasAll(['id', 'userId', 'bookId', 'chapterId']) &&
             data.id == progressId &&
             data.userId == request.auth.uid &&
             data.bookId is string && data.bookId.size() > 0 && data.bookId.size() <= 128 &&
             data.chapterId is string && data.chapterId.size() > 0 && data.chapterId.size() <= 128 &&
             (!('chapterIndex' in data) || (data.chapterIndex is int && data.chapterIndex >= 0)) &&
             (!('scrollPercent' in data) || (data.scrollPercent is number && data.scrollPercent >= 0 && data.scrollPercent <= 100)) &&
             (!('completed' in data) || data.completed is bool);
    }

    function isValidReadingProgressUpdate(progressId) {
      let incomingData = incoming();
      let existingData = existing();
      let affected = incomingData.diff(existingData).affectedKeys();
      return incomingData.id == progressId &&
             (!('id' in existingData) || existingData.id == progressId) &&
             incomingData.userId == existingData.userId &&
             incomingData.bookId == existingData.bookId &&
             incomingData.chapterId == existingData.chapterId &&
             affected.hasOnly(['id', 'chapterIndex', 'scrollPercent', 'lastReadAt', 'completed', 'updatedAt']) &&
             (!('chapterIndex' in incomingData) || (incomingData.chapterIndex is int && incomingData.chapterIndex >= 0)) &&
             (!('scrollPercent' in incomingData) || (incomingData.scrollPercent is number && incomingData.scrollPercent >= 0 && incomingData.scrollPercent <= 100)) &&
             (!('completed' in incomingData) || incomingData.completed is bool);
    }

    match /readingProgress/{progressId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(progressId) && isValidReadingProgressCreate(progressId);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidReadingProgressUpdate(progressId);
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // 10. Book Draft Chapters:
    // Strictly confidential! Only verified Admins and Owner can read, create, update, or delete draft chapters.
    // Public users have ZERO read or write access.
    match /bookDraftChapters/{draftId} {
      allow read: if isAdmin() && isValidId(draftId);
      allow create: if isValidDraftChapterCreate(draftId);
      allow update: if isValidDraftChapterUpdate(draftId);
      allow delete: if isAdmin() && isValidId(draftId);
    }
  }
}

