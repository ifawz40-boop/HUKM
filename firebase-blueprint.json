{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Reader profile information, bookmarks, and read history.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 100 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 256 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "avatar": { "type": "string", "maxLength": 1024 },
        "bio": { "type": "string", "maxLength": 1000 },
        "joinedDate": { "type": "string", "maxLength": 64 },
        "bookmarks": { "type": "array", "items": { "type": "string" } },
        "readHistory": { "type": "array", "items": { "type": "string" } },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid"]
    },
    "BookProject": {
      "title": "BookProject",
      "description": "Represents a research book or investigative project published on HUKM MEDIA.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 256 },
        "subtitle": { "type": "string", "maxLength": 512 },
        "author": { "type": "string", "maxLength": 128 },
        "category": { "type": "string", "maxLength": 64 },
        "coverImage": { "type": "string", "maxLength": 1024 },
        "status": { "type": "string", "enum": ["published", "completed", "ongoing", "ready", "draft"] },
        "summary": { "type": "string", "maxLength": 4096 },
        "viewsCount": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "title", "category", "status"]
    },
    "CategoryItem": {
      "title": "CategoryItem",
      "description": "Dynamic categories and pillars for organizing HUKM knowledge projects.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 128 },
        "description": { "type": "string", "maxLength": 512 }
      },
      "required": ["id", "name"]
    },
    "AdminAccount": {
      "title": "AdminAccount",
      "description": "Official administrators and editors authorized by Founder Dr. Islam Mohamed.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 128 },
        "addedBy": { "type": "string", "maxLength": 128 },
        "addedAt": { "type": "string", "maxLength": 64 },
        "isFounder": { "type": "boolean" },
        "canEditBooks": { "type": "boolean" },
        "canManageBans": { "type": "boolean" }
      },
      "required": ["id", "uid", "email", "name"]
    },
    "BannedAccount": {
      "title": "BannedAccount",
      "description": "Accounts suspended or restricted from accessing HUKM platform for policy violations.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "banType": { "type": "string", "enum": ["temporary", "permanent"] },
        "reason": { "type": "string", "maxLength": 1024 },
        "bannedBy": { "type": "string", "maxLength": 128 },
        "bannedAt": { "type": "string", "maxLength": 64 },
        "expiresAt": { "type": "string", "maxLength": 64 },
        "isActive": { "type": "boolean" }
      },
      "required": ["id", "email", "banType", "reason", "isActive"]
    },
    "HukmSubscriber": {
      "title": "HukmSubscriber",
      "description": "Automated email subscriber list receiving new chapter and investigation notifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "name": { "type": "string", "maxLength": 128 },
        "subscribedAt": { "type": "string", "maxLength": 64 },
        "source": { "type": "string", "maxLength": 64 },
        "active": { "type": "boolean" },
        "receiveAllReleases": { "type": "boolean" }
      },
      "required": ["id", "email", "active"]
    },
    "ReadingProgress": {
      "title": "ReadingProgress",
      "description": "Reader progress bookmarks per book and chapter.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "bookId": { "type": "string", "maxLength": 128 },
        "chapterId": { "type": "string", "maxLength": 128 },
        "chapterIndex": { "type": "number" },
        "scrollPercent": { "type": "number" },
        "lastReadAt": { "type": "string", "maxLength": 64 },
        "completed": { "type": "boolean" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["userId", "bookId", "chapterId"]
    },
    "BookDraftChapter": {
      "title": "BookDraftChapter",
      "description": "Confidential isolated draft chapter inaccessible to public readers.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "bookId": { "type": "string", "maxLength": 128 },
        "chapterNumber": { "type": "number" },
        "title": { "type": "string", "maxLength": 256 },
        "subtitle": { "type": "string", "maxLength": 512 },
        "content": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string", "maxLength": 4096 },
        "references": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["draft"] },
        "wordCount": { "type": "number" },
        "readingTimeMinutes": { "type": "number" },
        "viewsCount": { "type": "number" },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "bookId", "title", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile collection."
    },
    "/books/{bookId}": {
      "schema": { "$ref": "#/entities/BookProject" },
      "description": "Collection of all published books and investigation series."
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/CategoryItem" },
      "description": "Pillars and dynamic categories of HUKM MEDIA."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminAccount" },
      "description": "Official administrators and editors of the platform."
    },
    "/bans/{banId}": {
      "schema": { "$ref": "#/entities/BannedAccount" },
      "description": "Registry of banned/suspended accounts and moderation logs."
    },
    "/subscribers/{subscriberId}": {
      "schema": { "$ref": "#/entities/HukmSubscriber" },
      "description": "Subscribers registry for automatic email notifications."
    },
    "/readingProgress/{progressId}": {
      "schema": { "$ref": "#/entities/ReadingProgress" },
      "description": "Reading progress registry per user."
    },
    "/bookDraftChapters/{draftId}": {
      "schema": { "$ref": "#/entities/BookDraftChapter" },
      "description": "Isolated draft chapters collection accessible exclusively to verified administrators."
    }
  }
}

