# Client-side Firebase configuration is public app configuration, not an Admin credential.
# Keep all private service-account credentials out of GitHub and browser-prefixed variables.

# Required for Firebase Admin SDK on Vercel only.
# Paste the complete service-account JSON as a server-side Vercel Environment Variable.
# It must belong to project gen-lang-client-0492732633.
# Do not commit a real value here or expose it through a VITE_ variable.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Preferred sender: Gmail SMTP. Gmail takes priority when both providers are configured.
# Create an App Password in the Gmail account with 2-Step Verification enabled.
# Add the real App Password only in Vercel Environment Variables; never commit it.
GMAIL_USER="hukm.contact@gmail.com"
GMAIL_APP_PASSWORD="YOUR_GOOGLE_APP_PASSWORD"

# Optional fallback provider: Resend. Used only when Gmail credentials are absent.
# EMAIL_FROM must be a sender address verified in the Resend account.
RESEND_API_KEY="YOUR_RESEND_API_KEY"
EMAIL_FROM="HUKM MEDIA <updates@your-verified-domain.example>"

# GEMINI_API_KEY is not currently read by the shipped application code.
# Do not add a Gemini key unless a server-side feature is implemented to consume it.
